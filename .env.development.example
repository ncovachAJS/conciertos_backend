# `npm run start:dev` y `npm run db:*` leen este archivo, NO el .env de producción.

# Postgres local (docker-compose.yml). Alternativa: una rama/proyecto aparte en Neon.
DATABASE_URL="postgresql://neondb_owner:npg_VHe1k7gJIlrC@ep-lingering-fire-as4skwb5.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

