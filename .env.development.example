NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS="http://localhost:3000"

# Servicios externos: usa claves de desarrollo (o las mismas, son solo lectura)
# Opción A: token personal
DISCOGS_TOKEN="your_discogs_personal_token"
# Opción B: key + secret de la aplicación (si no hay token)
# DISCOGS_KEY=""
# DISCOGS_SECRET=""
SETLIST_API_KEY="your_setlistfm_api_key"
TICKETMASTER_API_KEY="your_ticketmaster_api_key"
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# Cloudinary: usa un cloud/carpeta de pruebas para no mezclar imágenes con producción
CLOUDINARY_CLOUD_NAME="your_dev_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Firebase Admin: el arranque falla si faltan. Idealmente un proyecto Firebase de desarrollo.
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
